<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Splash Screen -->
    <style name="Theme.Netscape.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splashscreen_bg_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.Netscape</item>
    </style>

    <!-- Main App Theme -->
    <style name="Theme.Netscape" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

</resources>
